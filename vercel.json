{
  "buildCommand": "npm install",
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "website-draft/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "website-draft/$1"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
